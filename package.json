{
  "name": "coop-finder",
  "version": "0.1.0",
  "description": "Bot Discord pour trouver à quoi jouer entre amis sur Steam",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types",
    "register": "tsx --env-file=.dev.vars scripts/registerCommands.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0"
  }
}
